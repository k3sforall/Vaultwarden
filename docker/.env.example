# Copy to .env and fill in real values (the .env file is gitignored).
#
# ADMIN_TOKEN: the Vaultwarden admin token. Reuse the existing one from k3s:
#   kubectl -n default get secret vaultwarden-admin-token \
#     -o jsonpath='{.data.ADMIN_TOKEN}' | base64 -d
ADMIN_TOKEN=

# CF_API_TOKEN: Cloudflare API token (DNS edit) for Phase B auto-renew. Reuse:
#   kubectl -n cert-manager get secret cloudflare-api-token-secret \
#     -o jsonpath='{.data.api-token}' | base64 -d
CF_API_TOKEN=
